# Copy to .env for local dev, or export these in CI/automation.
# These env vars beat the settings file and the keychain. --read-only is the only flag that overrides them.

# Your Teamwork site — the part before .teamwork.com.
# `teamwork login` discovers this from your API key, so you rarely need it.
TEAMWORK_SITE_NAME=

# API key. Interactively, prefer `teamwork login` (stored in the OS keychain).
# In CI and for agents, set this instead — the keychain is usually unavailable.
TEAMWORK_API_KEY=

# Refuse every command that would change remote data. The safe posture for
# agents and automation.
# TEAMWORK_READ_ONLY=1

# Use this settings file instead of the default one (`teamwork config path`).
# TEAMWORK_CLI_CONFIG_FILE=./teamwork-config.json

# For tests only: send requests to a server on this machine (127.0.0.1 or localhost)
# instead of https://<site>.teamwork.com. Any other address is refused.
# TEAMWORK_BASE_URL=

# The settings folder follows the platform: XDG_CONFIG_HOME where it is set, and
# APPDATA on Windows.

# Force the in-memory credential store instead of the OS keychain. Tests set
# this so they can never touch real credentials.
# TEAMWORK_CLI_CREDENTIAL_STORE=memory
# Where the key is kept when the OS keychain is closed (as over SSH on macOS):
# TEAMWORK_CLI_CREDENTIALS_FILE=./credentials.json

# Stop `teamwork login` opening a browser. Set suite-wide in vitest.config.ts,
# and useful on a headless box where the hand-off has nowhere to land.
# TEAMWORK_CLI_NO_BROWSER=1
